# In-world control server (worldctl): brokers HTTP to the agent adapters.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# curl is only for healthchecks; the server itself is stdlib.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir json_repair

WORKDIR /app
COPY wildawm/__init__.py /app/wildawm/__init__.py
COPY wildawm/json_utils.py /app/wildawm/json_utils.py
COPY wildawm/const_config.py /app/wildawm/const_config.py
COPY wildawm/worldctl/ /app/wildawm/worldctl/

EXPOSE 8300

ENTRYPOINT ["python3", "-u", "-m", "wildawm.worldctl.server"]

# Copy to `.env` and fill in values; nothing deployment-specific is baked into the code.

# Run-data root (optional): relocates worlds/, tasks_xai/, outputs/, runtime/ and logs/ at once.
#WILDAWM_DATA_ROOT=/path/to/your/run-data

# Synthesis model (required): a 'provider/model' ref from models.json; all roles default to it.
WILDAWM_SYNTH_MODEL_REF=your-provider/your-model
# Host-side OpenAI-compatible proxy for the claude-code agent, e.g. http://172.17.0.1:8787/v1.
WILDAWM_OPENAI_HOST_PROXY_URL=
# Heavy-judge Anthropic->OpenAI proxy; leave empty to auto-start the built-in shim.
WILDAWM_HEAVY_JUDGE_PROXY=

# Vision LLM behind the describe_image MCP (required for text-only models; no default).
WILDAWM_VISION_BASE_URL=
WILDAWM_VISION_API_KEY=
WILDAWM_VISION_MODEL=
# Optional second backend:
WILDAWM_VISION_FALLBACK_BASE_URL=
WILDAWM_VISION_FALLBACK_API_KEY=
WILDAWM_VISION_FALLBACK_MODEL=

# Ensemble solver pool (required for task synthesis): CSV of models.json refs and harness names.
# Harnesses: claude-code, opencode, codex, nanobot, openclaw, hermes
WILDAWM_ENSEMBLE_MODELS=your-provider/model-a,your-provider/model-b
WILDAWM_ENSEMBLE_HARNESSES=opencode,codex,claude-code
# Iteration and quality-gate knobs (defaults are in wildawm/const_config.py):
#WILDAWM_SYNTHESIS_CONFIG=configs/synthesis.jsonc
# Lightweight judge reasoning effort; empty uses the judge model's registry default.
#AWM_LIGHTWEIGHT_JUDGE_REASONING_EFFORT=high
#AWM_ENSEMBLE_N=3
#AWM_LIVE_TEST_N=3
#AWM_STEP_GATE=30
#AWM_MAX_DEEPEN=2
#AWM_MAX_EASE=2
#AWM_MAX_INTERFACE_REAUTHOR=2
#AWM_MAX_CAVE_FIX=2
#AWM_MAX_FIX_ITERS=2
#AWM_MAX_GENERATION_ITERS=2
#AWM_MAX_AGREE_FIX=2
#AWM_MAX_POST_FIX_VALIDATE_FIXES=2
# Bare difficulty bands: completion counts over AWM_LIVE_TEST_N (default hard k<=1, medium k=2).
#AWM_BARE_HARD_MAX_COMPLETED=1
#AWM_BARE_MEDIUM_MIN_COMPLETED=2
#AWM_BARE_MEDIUM_MAX_COMPLETED=2
#AWM_WORLD_SYN_SKILL_TIMEOUT=1800
#AWM_WORLD_SYN_SKILL_MAX_TURNS=40
#AWM_WORLD_SYN_SKILL_INDEX_CHARS=24000

# Docker host gateway (optional): override only for non-default bridge networks.
#WILDAWM_DOCKER_HOST_GATEWAY=172.17.0.1

# Claude Code credentials copied into the synthesis agent container (claude-code harness only).
#WILDAWM_CLAUDE_CREDENTIALS=/home/you/.claude/.credentials.json

# docker-compose defaults; the dashboard normally allocates these per world.
AWM_WORLD_ID=default
AWM_DASHBOARD_PORT=8624
AWM_MCP_INTERNAL_PORT=8080
AWM_AGENT_INTERNAL_PORT=8900
AWM_OPENCODE_INTERNAL_PORT=4096
AWM_WORLDCTL_PORT=8300
AWM_AGENT_ADAPTER_PORT=8999
AWM_LLM_PROXY_PORT=3456
AWM_BROWSER_MCP_PORT=8931
AWM_WEBHARBOR_CTRL_PORT=8101
AWM_OPENAI_HOST_PROXY_PORT=8787

# Per-container CPU/memory ceilings (compose defaults shown); every replicated stack gets these.
AWM_AGENT_CPUS=2.0
AWM_AGENT_MEM_LIMIT=6g
AWM_MCP_CPUS=1.0
AWM_MCP_MEM_LIMIT=2g
AWM_WEBHARBOR_CPUS=2.0
AWM_WEBHARBOR_MEM_LIMIT=4g
AWM_WORLDCTL_CPUS=1.0
AWM_WORLDCTL_MEM_LIMIT=1g
